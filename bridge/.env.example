# Copy to .env (or export in your shell). Never commit real keys.

# --- relay ports ---
RELAY_PORT=8443
RELAY_PLAIN_PORT=8444

# --- downlink audio ---
DOWNLINK_CODEC=opus
OPUS_BITRATE=24000

# --- agent gateway (OpenAI compatible) ---
RELAY_API_KEY=
HERMES_ENV_FILE=~/.hermes/.env

# --- ASR (Volcengine streaming) ---
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_ACCESS_TOKEN=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# --- DDNS (Cloudflare) ---
DDNS_ZONE=example.com
DDNS_RECORD=watch.example.com
DDNS_IFACE=eth0
CF_TOKEN_FILE=~/.config/qiuqiu/cf_dns_token.txt
